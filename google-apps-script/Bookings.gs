/** TAREK RIJSCHOOL — Lesson Operations. */
function apiCreateBooking(params){const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName('Lessons'),settings=ss.getSheetByName('SchoolSettings');if(!sh||!settings)throw new Error('Required lesson sheets are missing.');const sid=String(params&&params.studentId||'').trim(),tid=String(params&&params.trainerId||'').trim(),date=String(params&&params.date||'').trim(),time=String(params&&params.time||'').trim(),duration=Number(params&&params.duration||1),pickup=String(params&&params.pickupLocation||'').trim();if(!sid||!tid)throw new Error('Student and trainer are required.');if(!/^\d{4}-\d{2}-\d{2}$/.test(date))throw new Error('Lesson date must use YYYY-MM-DD.');if(!/^\d{2}:\d{2}$/.test(time))throw new Error('Lesson time must use HH:MM.');if(!(duration>0&&duration<=8))throw new Error('Lesson duration must be between 1 and 8 hours.');const student=apiGetStudentDashboard(sid).student,trainer=apiGetTrainerDashboard(tid).trainer;let baseRate=Number(trainer.rate)||0;if(!baseRate){const h=settings.getRange(1,1,1,settings.getLastColumn()).getDisplayValues()[0],r=settings.getLastRow()>=2?settings.getRange(2,1,1,h.length).getValues()[0]:[],idx=h.indexOf('lessonPricePerHour');baseRate=idx>=0?Number(r[idx])||0:0}if(!baseRate)throw new Error('Lesson price per hour is not configured.');const price=duration*baseRate;if(Number(student.balance)<price)throw new Error('Insufficient student wallet balance. Price: €'+price+' Current: €'+student.balance);const id='LES-'+Date.now();sh.appendRow([id,student.id,student.name,trainer.name,date,time,duration,price,pickup,'upcoming','',String(params.instructorNotes||''),'']);writeTransactionRecord(student.id,student.name,'payment',price,'Reserved driving lesson ('+id+') on '+date+' at '+time);rebuildStudentBalance(student.id);if(student.email&&typeof sendResponsiveEmail==='function')sendResponsiveEmail(student.email,student.name,'booking',{date,time,duration,pickupLocation:pickup,price});if(typeof writeAdminLog==='function')writeAdminLog('Create Lesson API','Master Control Center','Scheduled '+id+' for '+student.name);return{bookingId:id,eventId:'',price}}
function apiGetStudentsAndTrainers(){const ss=SpreadsheetApp.getActiveSpreadsheet(),students=ss.getSheetByName('Students'),trainers=ss.getSheetByName('Trainers');if(!students||!trainers)throw new Error('Students or Trainers sheet is missing.');const s=students.getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:r[0],name:r[1],balance:Number(r[7])||0})),t=trainers.getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:r[0],name:r[1],rate:Number(r[6])||0,status:r[7]}));return{students:s,trainers:t}}
function menuAddLesson(){SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutputFromFile('AddLessonDialog').setWidth(760).setHeight(650),'Add Lesson')}
function createCalendarBooking(){return''}function createBooking(params){return apiCreateBooking(params)}function completeLesson(params){return apiCompleteLesson(params)}function saveRoute(params){return apiSaveRoute(params)}function getRoute(id){return apiGetRoute(id)}
