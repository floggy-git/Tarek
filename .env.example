# Gemini API key. Provide only through the server runtime secret store.
GEMINI_API_KEY=

# Firebase project ID used by the server to validate Firebase ID tokens.
# Must match the Firebase project that issues authenticated application tokens.
FIREBASE_PROJECT_ID=

# Public application URL used by the server when an absolute URL is required.
APP_URL=

# Google Sheets Apps Script Web App URL, if this deployment path is enabled.
# Deploy the web app with the minimum access required by your authentication boundary.
# Never publish or commit a real deployment URL containing credentials or secrets.
VITE_GOOGLE_SHEETS_WEB_APP_URL=

# SMTP configuration for real email delivery. Leave empty when email is disabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Webhook authentication secret. REQUIRED at runtime for authenticated Sheets webhooks.
# Do not commit the value to the repository.
SHEETS_WEBHOOK_SECRET=

# Administrator authentication secret. REQUIRED at runtime for protected admin operations.
# Do not commit the value to the repository.
ADMIN_SECRET_KEY=
